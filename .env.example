# ============================================================
#  PawPredict AI — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to git.
# ============================================================

# Your Anthropic API key — stays server-side only
# Get it at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Rate limiting: max requests per IP per window (default: 10 per minute)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Neon Postgres (added by the Vercel Neon integration) — case queue
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Vercel Blob (PRIVATE store) — case photos
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# Your production domain (used for CORS validation)
# e.g. https://pawpredict.ai  — no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000
